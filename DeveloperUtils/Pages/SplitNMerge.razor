@page "/SplitNMerge"

<h3>Split N Merge</h3>

<table class="table">
	<thead>
		<tr>
			<th>Input Data to split/merge</th>
			<th> Options </th>
			<th>Result</th>
		</tr>
	</thead>
	<tbody style="height: 80%">
		<tr style="height: 80%">
			<td style="width: 40%"><textarea style="width:90%;height: 85%" @bind="_input" /></td>
			<td style="text-align: center; width: 10%">
				<div style="margin: 10px">
					convert
					<select name="convertFromList" class="btn user-select-all" @bind="_matcher">
						<option value=","> , </option>
						<option value="|"> | </option>
						<option value=":"> : </option>
						<option value=";"> ; </option>
						<option value="\r\n"> NewLine </option>
					</select>
					<p> to </p>
					<select name="convertToList" class="btn user-select-all" @bind="_converter">
						<option value="," selected> , </option>
						<option value="|"> | </option>
						<option value=":"> : </option>
						<option value=";"> ; </option>
						<option value="\r\n"> NewLine </option>
					</select>
				</div>
				<div style="margin: 10px">
					<button class="btn btn-primary" @onclick="ConvertInput">&gt;</button>
				</div>
				<div style="margin: 10px">
					<button class="btn btn-secondary">&lt;</button>
				</div>
			</td>
			<td style="width: 40%"><textarea style="width:90%;height: 85%" @bind="_finalOutput" /></td>
		</tr>
	</tbody>
</table>

@code {
	private string _input;
	private string _finalOutput;
	private string _converter;
	private string _matcher;
	void ConvertInput()
	{
		if (_matcher == "\\r\\n") _matcher = Environment.NewLine;
		var initalConvertedVal = _input.Replace(_matcher, _converter);
		_finalOutput = initalConvertedVal;
	}
}
